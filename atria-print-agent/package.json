{
  "name": "atria-print-agent",
  "version": "0.1.0",
  "private": true,
  "description": "Atria Print Agent — puente local HTTP → spooler (L'Scala / Atria Solutions SpA)",
  "type": "module",
  "main": "dist/main.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "start": "node dist/main.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "tsx --test src/jobs/*.test.ts src/printer/*.test.ts src/printer/macos/*.test.ts src/printer/windows/*.test.ts src/macos/*.test.ts",
    "pack:mac": "node packaging/scripts/pack-mac.mjs",
    "pack:win": "node packaging/scripts/pack-win.mjs",
    "pack": "npm run pack:mac"
  },
  "dependencies": {
    "express": "^4.21.2",
    "tray-hook": "^1.1.1"
  },
  "devDependencies": {
    "@types/express": "^4.17.21",
    "@types/node": "^22.13.10",
    "esbuild": "^0.25.0",
    "tsx": "^4.19.3",
    "typescript": "^5.8.2"
  }
}
